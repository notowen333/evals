{
  "family": "harbor-benchmark-worker",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "879381280403.dkr.ecr.us-east-1.amazonaws.com/harbor-worker:latest",
      "privileged": true,
      "memory": 8192,
      "cpu": 4096,
      "essential": true,
      "environment": [
        { "name": "BENCHMARK_S3_BUCKET", "value": "strands-benchmark-results" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "results",
          "containerPath": "/results"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/harbor-benchmark",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "results",
      "host": { "sourcePath": "/tmp/harbor-results" }
    }
  ],
  "taskRoleArn": "<YOUR_TASK_ROLE_ARN>",
  "executionRoleArn": "<YOUR_EXECUTION_ROLE_ARN>"
}
